  "referenceSolution": [
    {
      "remember": "acorns",
      "kind": "grid",
      "of": "yesNo",
      "start": "board:acorns"
    },
    {
      "remember": "spot",
      "kind": "position",
      "start": {
        "x": 0,
        "y": 0
      }
    },
    {
      "remember": "acorn",
      "kind": "yesNo",
      "start": false
    },
    {
      "remember": "count",
      "kind": "number",
      "start": 0
    },
    {
      "repeat": 3,
      "do": [
        {
          "repeat": 4,
          "do": [
            {
              "set": "acorn",
              "to": "read:acorns@spot"
            },
            {
              "if": "slot:acorn=yes",
              "do": [
                {
                  "change": "count",
                  "by": 1
                }
              ]
            },
            {
              "shift": "spot",
              "dir": "E"
            }
          ]
        },
        {
          "repeat": 4,
          "do": [
            {
              "shift": "spot",
              "dir": "W"
            }
          ]
        },
        {
          "shift": "spot",
          "dir": "S"
        }
      ]
    }
  ],
