  "referenceSolution": [
    {
      "remember": "crates",
      "kind": "list",
      "of": "yesNo",
      "start": [
        false,
        false,
        true,
        false,
        true
      ]
    },
    {
      "remember": "crate",
      "kind": "yesNo",
      "start": false
    },
    {
      "remember": "found",
      "kind": "yesNo",
      "start": false
    },
    {
      "forEach": "crates",
      "as": "crate",
      "do": [
        {
          "if": "slot:crate=yes",
          "do": [
            {
              "set": "found",
              "to": true
            }
          ]
        },
        {
          "if": "slot:found=no",
          "do": [
            "forward"
          ]
        }
      ]
    }
  ],
