      "world": {
        "rows": [
          "..."
        ],
        "robot": {
          "x": 0,
          "y": 0,
          "facing": "E"
        },
        "goal": {
          "x": 2,
          "y": 0
        },
        "collectibles": [
          {
            "x": 1,
            "y": 0
          }
        ]
      },
      "program": [
        {
          "remember": "seen",
          "kind": "yesNo",
          "start": false
        },
        {
          "remember": "got",
          "kind": "number",
          "start": 0
        },
        {
          "set": "seen",
          "to": "acornAhead"
        },
        "forward",
        "forward",
        {
          "set": "got",
          "to": "acorns"
        }
      ]
    }
  },
