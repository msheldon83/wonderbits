{
  "schemaVersion": 1,
  "id": "acorn-chase",
  "title": "Acorn chase",
  "family": "real-time",
  "blurb": "Collect every acorn while a beetle chases you round the rocks. How fast can you do it?",
  "how": "Use the arrow keys to pick up every acorn. The beetle is after you: keep the rocks between you and it.",
  "world": {
    "rows": [
      ".......",
      ".#.#.#.",
      ".......",
      ".#.#.#.",
      "......."
    ],
    "robot": {
      "x": 0,
      "y": 4,
      "facing": "N"
    },
