    },
    {
      "remember": "column",
      "kind": "number",
      "start": 0
    },
    {
      "remember": "row",
      "kind": "number",
      "start": 0
    },
    {
      "remember": "yes",
      "kind": "yesNo",
      "start": true
    },
    {
      "remember": "mine",
      "kind": "yesNo",
      "start": false
    },
    {
      "remember": "seen",
      "kind": "number",
      "start": 0
    },
    {
      "remember": "hidden",
      "kind": "number",
      "start": 0
    },
    {
      "remember": "left",
      "kind": "number",
      "start": 25
    },
    {
      "repeat": 4,
      "do": [
        {
          "set": "column",
          "to": "random:0-4"
        },
        {
          "set": "row",
          "to": "random:0-4"
        },
        {
          "fly": "spot",
          "column": "column",
          "row": "row"
        },
        {
          "set": "mine",
          "to": "read:mines@spot"
        },
        {
          "if": "slot:mine=no",
          "do": [
            {
              "mark": "mines",
              "at": "spot",
              "with": "yes"
            },
            {
              "change": "hidden",
              "by": 1
            }
          ]
        }
      ]
    },
    {
      "on": "tap",
      "do": [
        {
          "set": "seen",
          "to": "read:shown@tap"
        },
        {
          "if": "slot:seen=9",
          "do": [
            {
              "set": "mine",
              "to": "read:mines@tap"
            },
            {
              "if": "slot:mine=yes",
              "do": [
                "lose"
              ],
              "else": [
                {
                  "uncover": "shown",
                  "mines": "mines",
                  "at": "tap"
                },
                {
                  "set": "left",
                  "to": "count:shown=9"
                },
                {
                  "if": "slot:left=hidden",
                  "do": [
                    "win"
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "tries": [
