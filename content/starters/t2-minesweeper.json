      "start": false
    },
    {
      "remember": "count",
      "kind": "number",
      "start": 0
    },
    {
      "remember": "seen",
      "kind": "number",
      "start": 0
    },
    {
      "remember": "left",
      "kind": "number",
      "start": 25
    },
    {
      "repeat": 4,
      "do": [
        {
          "set": "column",
          "to": "random:0-4"
        },
        {
          "set": "row",
          "to": "random:0-4"
        },
        {
          "fly": "spot",
          "column": "column",
          "row": "row"
        },
        {
          "set": "mine",
          "to": "read:mines@spot"
        },
        {
          "if": "slot:mine=no",
          "do": [
            {
              "mark": "mines",
              "at": "spot",
              "with": "yes"
            },
            {
              "change": "left",
              "by": -1
            }
          ]
        }
      ]
    },
    {
      "define": "look",
      "do": [
        {
          "set": "mine",
          "to": "read:mines@spot"
        },
        {
          "if": "slot:mine=yes",
          "do": [
            {
              "change": "count",
              "by": 1
            }
          ]
        }
      ]
    },
    {
      "define": "countAround",
      "do": [
        {
          "set": "count",
          "to": 0
        },
        {
          "set": "spot",
          "to": "whole:tap"
        },
        {
          "shift": "spot",
          "dir": "N"
        },
        {
          "call": "look"
        },
        {
          "shift": "spot",
          "dir": "E"
        },
        {
          "call": "look"
        },
        {
          "shift": "spot",
          "dir": "S"
        },
        {
          "call": "look"
        },
        {
          "shift": "spot",
          "dir": "S"
        },
        {
          "call": "look"
        },
        {
          "shift": "spot",
          "dir": "W"
        },
        {
          "call": "look"
        },
        {
          "shift": "spot",
          "dir": "W"
        },
        {
          "call": "look"
        },
        {
          "shift": "spot",
          "dir": "N"
        },
        {
          "call": "look"
        },
        {
          "shift": "spot",
          "dir": "N"
        },
        {
          "call": "look"
        }
      ]
    },
    {
      "on": "tap",
      "do": [
        {
          "set": "seen",
          "to": "read:shown@tap"
        },
        {
          "if": "slot:seen=9",
          "do": [
            {
              "set": "mine",
              "to": "read:mines@tap"
            },
            {
              "if": "slot:mine=yes",
              "do": [
                "lose"
              ],
              "else": [
                {
                  "call": "countAround"
                },
                {
                  "mark": "shown",
                  "at": "tap",
                  "with": "count"
                },
                {
                  "change": "left",
                  "by": -1
                },
                {
                  "if": "slot:left=0",
                  "do": [
                    "win"
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
